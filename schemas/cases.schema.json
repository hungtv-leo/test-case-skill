{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://self-test-cases.local/schemas/cases.schema.json",
  "title": "cases.json",
  "description": "Metadata test case cho skill self-test-cases. Key la test id (verified) hoac gap:<case_id> (gap chua automate).",
  "type": "object",
  "minProperties": 1,
  "patternProperties": {
    "^__.*__$": {
      "type": "string",
      "description": "Metadata noi bo (vd __NOTE__). Khong phai test case."
    },
    "^(?!__.*__$).+$": {
      "type": "object",
      "required": ["case_id", "description", "precondition", "steps", "expected", "coverage"],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "description": "Ma case hien thi cho tester, vd TC-01"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Mo ta ngan gon muc tieu test"
        },
        "precondition": {
          "type": "string",
          "description": "Dieu kien tien de truoc khi chay case"
        },
        "steps": {
          "description": "Cac buoc thuc hien, tester-friendly",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            { "type": "string", "minLength": 1 }
          ]
        },
        "data": {
          "description": "Du lieu dau vao hoac payload mau",
          "oneOf": [
            { "type": "object" },
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "description": "Ket qua mong doi, ghi ro status/message neu la loi"
        },
        "coverage": {
          "type": "string",
          "enum": ["verified", "gap", "exploratory", "needs-product-decision"],
          "description": "verified = code da check + co test tu dong; gap/exploratory/needs-product-decision = case co the xay ra ma code chua xu ly / can tester"
        },
        "category": {
          "type": "string",
          "enum": [
            "happy",
            "validate",
            "auth",
            "state",
            "race",
            "boundary",
            "side-effect",
            "dependency",
            "other"
          ],
          "description": "Nhom rui ro / loai case"
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"],
          "description": "Do uu tien cho tester/dev"
        },
        "code_evidence": {
          "type": "string",
          "description": "Bang chung trong code: file/symbol/nhanh chua check gi"
        },
        "tester_note": {
          "type": "string",
          "description": "Huong dan tester tai hien tren moi truong that (khong mock)"
        },
        "risk": {
          "type": "string",
          "description": "Hau qua neu bo sot case nay"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "coverage": { "enum": ["gap", "exploratory", "needs-product-decision"] } },
            "required": ["coverage"]
          },
          "then": {
            "required": ["code_evidence", "risk"]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
